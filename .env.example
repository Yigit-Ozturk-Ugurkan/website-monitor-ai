# =========================
# DATABASE
# =========================
DATABASE_URL=postgresql://username:password@localhost:5432/website_monitor_ai


# =========================
# GEMINI
# =========================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash


# =========================
# APPLICATION
# =========================
APP_TIMEZONE=Europe/Istanbul
APP_BASE_URL=http://localhost:5173

# Opsiyonel ek CA sertifika dosyasi (PEM).
# Ara sertifikasini gondermeyen sunucular icin.
# Sertifika dogrulamasini KAPATMAZ.
EXTRA_CA_BUNDLE=


# =========================
# SMTP / EMAIL NOTIFICATIONS
# =========================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Website Monitor AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional: only for manual email smoke tests
SMTP_TEST_TO=